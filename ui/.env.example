# Beeper UI Configuration
# Copy this file to .env and modify as needed

# Flask environment: development, testing, production
FLASK_ENV=development

# Secret key for session management (change in production!)
SECRET_KEY=change-this-in-production

# Operator API URL - where the Beeper operator is running
BEEPER_OPERATOR_URL=http://localhost:8080

# Operator API timeout in seconds
BEEPER_OPERATOR_TIMEOUT=5.0

# UI server settings
BEEPER_UI_PORT=5000
BEEPER_UI_HOST=0.0.0.0
