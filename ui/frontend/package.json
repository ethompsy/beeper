{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "types": "dist-lib/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -b && vite build --config vite.lib.config.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src",
    "lint:tw": "eslint --config eslint.config.mjs 'src/**/*.{ts,tsx}'",
    "lint:terms": "node scripts/check-legacy-labels.mjs",
    "preview": "vite preview",
    "verify-build": "node scripts/verify-build.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-tailwindcss": "^4.0.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  }
}
