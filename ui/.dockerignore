# Keep host build artifacts out of the Docker context: the node-builder stage
# runs `npm ci` and `npm run build` itself — host node_modules (platform
# binaries) and outputs must not overwrite them via `COPY frontend/ ./`.
frontend/node_modules
frontend/dist
frontend/dist-lib
frontend/playwright-report
frontend/test-results
frontend/storybook-static
.venv
.pytest_cache
.mypy_cache
.ruff_cache
