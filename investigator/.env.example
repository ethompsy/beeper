# Beeper Investigator Configuration
# Copy this file to .env for local development

# LLM Provider Configuration
# Supported providers: anthropic, openai, azure, ollama
BEEPER_LLM_PROVIDER=anthropic

# Model identifier (depends on provider)
# Anthropic: claude-sonnet-4, claude-3-haiku, claude-opus-4
# OpenAI: gpt-4o, gpt-4-turbo
# Azure: azure/<deployment-name>
# Ollama: ollama/llama3
BEEPER_LLM_MODEL=claude-sonnet-4

# API Key (required for cloud providers, not needed for Ollama)
# Get your Anthropic key from: https://console.anthropic.com/
# Get your OpenAI key from: https://platform.openai.com/api-keys
BEEPER_LLM_API_KEY=your-api-key-here

# Optional: Custom endpoint (required for Azure, optional for Ollama)
# BEEPER_LLM_ENDPOINT=

# Knowledge Base (Qdrant) Configuration
BEEPER_QDRANT_URL=http://localhost:6333

# Operator API URL
BEEPER_OPERATOR_URL=http://localhost:8080
